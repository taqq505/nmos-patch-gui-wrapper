{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NMOS Simple BCC",
  "version": "0.1.0",
  "identifier": "com.taqq505.nmospatchgui.wrapper",
  "build": {
    "frontendDist": "../webapp"
  },
  "app": {
    "windows": [
      {
        "title": "NMOS Simple BCC",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-web-security --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IsolateOrigins,site-per-process"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
